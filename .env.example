APP_ENV=local
APP_NAME=GeoCredit AI
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
LOG_LEVEL=debug
TZ=UTC
DISPLAY_TIMEZONE=Asia/Dhaka
DATABASE_URL=postgres://geocredit:geocredit@127.0.0.1:55432/geocredit
AUTH_PROVIDER=development
AUTH_SESSION_SECRET=replace-with-local-secret
AUTH_JWT_SECRET=replace-with-a-long-random-production-secret
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
MEDIA_STORAGE_PROVIDER=minio
MEDIA_PRIVATE_ROOT=./private-media
MEDIA_UPLOAD_TTL_SECONDS=900
MINIO_ENDPOINT=http://127.0.0.1:59000
MINIO_PUBLIC_ENDPOINT=http://localhost:59000
MINIO_BUCKET=geocredit-private
MINIO_REGION=us-east-1
MINIO_ROOT_USER=geocreditminio
MINIO_ROOT_PASSWORD=geocreditminiosecret
MIN_AREA_COHORT=5
GPS_MAX_ACCURACY_METERS=75
