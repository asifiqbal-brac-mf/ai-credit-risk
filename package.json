{
  "name": "geocredit-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm.cmd run dev -w @geocredit/api",
    "build": "npm.cmd run build --workspaces --if-present",
    "lint": "npm.cmd run lint --workspaces --if-present",
    "typecheck": "npm.cmd run typecheck --workspaces --if-present",
    "test": "npm.cmd run test --workspaces --if-present",
    "pretest": "npm.cmd run build --workspace @geocredit/types && npm.cmd run build --workspace @geocredit/validation && npm.cmd run build --workspace @geocredit/workflow && npm.cmd run build --workspace @geocredit/risk-engine",
    "db:migrate": "tsx database/scripts/run-sql.ts migrate",
    "seed": "tsx database/scripts/run-sql.ts seed",
    "seed:verify": "tsx database/scripts/run-sql.ts verify",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "expo-blob": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "exponential-backoff": "^3.1.3",
    "glob": "^10.4.5",
    "pg": "^8.13.1",
    "react-native-safe-area-context": "~5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
